# Copy to .env and fill in. .env is gitignored.

# Contact sent in every outbound User-Agent (Wikimedia User-Agent policy). Email or URL.
WIKIPULSE_HTTP__CONTACT=

# Lake and raw files. On the development machine this is the external HDD, for example
# /media/<user>/<drive>/wikipulse. Services refuse to start if it is not mounted and writable.
WIKIPULSE_DATA_ROOT=./data

# Pseudonymisation key for editor identifiers: 64 hex characters (python3 -c "import secrets; print(secrets.token_hex(32))").
WIKIPULSE_PRIVACY__HMAC_KEY=

# Local PostgreSQL passwords.
POSTGRES_PASSWORD=
WIKIPULSE_POSTGRES__PASSWORD=
WIKIPULSE_POSTGRES__READER_PASSWORD=

# Grafana admin password.
GF_SECURITY_ADMIN_PASSWORD=
